# Copy this file to .env and replace each placeholder with your own project values.
# Do not commit .env or share the database password.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>
SUPABASE_JDBC_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-database-password>
