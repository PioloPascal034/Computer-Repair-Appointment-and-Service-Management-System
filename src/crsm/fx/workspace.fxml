<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" styleClass="workspace-root">
    <left>
        <VBox fx:id="sidebar" prefWidth="236" spacing="10" styleClass="sidebar">
            <VBox spacing="2" styleClass="sidebar-brand"><Label text="CRSM" styleClass="sidebar-logo"/><Label text="COMPUTER REPAIR SERVICE MANAGEMENT" styleClass="sidebar-subtitle" wrapText="true" maxWidth="Infinity"/></VBox>
            <Separator/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="navigation-scroll" VBox.vgrow="ALWAYS"><content><VBox fx:id="navigation" spacing="4"/></content></ScrollPane>
            <VBox spacing="8"><Label text="Manage repairs with confidence." styleClass="sidebar-note" wrapText="true"/><Button text="Sign out" onAction="#signOut" styleClass="sidebar-button" maxWidth="Infinity"/></VBox>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
                    <TextField fx:id="search" promptText="Search customers, devices, services, or repairs" HBox.hgrow="ALWAYS" onAction="#search"/>
                    <Button text="Search" onAction="#search" styleClass="primary-button"/>
                    <Label fx:id="userName" styleClass="top-user"/>
                    <Button text="My Account &#9662;" onAction="#accountMenu" styleClass="ghost-button"/>
                </HBox>
            </top>
            <center><StackPane fx:id="content" styleClass="content-area"/></center>
        </BorderPane>
    </center>
</BorderPane>
